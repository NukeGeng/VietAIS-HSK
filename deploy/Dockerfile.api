FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/VietAisHsk.Api/VietAisHsk.Api.csproj backend/VietAisHsk.Api/
RUN dotnet restore backend/VietAisHsk.Api/VietAisHsk.Api.csproj

COPY backend/ backend/
RUN dotnet publish backend/VietAisHsk.Api/VietAisHsk.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Keep the runtime image observable by Compose/Kubernetes without shipping a full shell-based
# diagnostic toolchain. The healthcheck only calls the local liveness endpoint.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
    CMD curl --fail --silent http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["dotnet", "VietAisHsk.Api.dll"]
